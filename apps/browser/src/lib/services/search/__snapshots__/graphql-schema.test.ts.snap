// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`search GraphQL contract > emits a stable SDL for the dataset search schema 1`] = `
"type Query {
  datasets(query: String, where: DatasetWhere, orderBy: DatasetOrderBy, page: Int = 1, perPage: Int = 20): DatasetSearchResult!
  organizations(query: String, where: OrganizationWhere, orderBy: OrganizationOrderBy, page: Int = 1, perPage: Int = 20): OrganizationSearchResult!
  classs(query: String, where: ClassWhere, orderBy: ClassOrderBy, page: Int = 1, perPage: Int = 20): ClassSearchResult!
  terminologySources(query: String, where: TerminologySourceWhere, orderBy: TerminologySourceOrderBy, page: Int = 1, perPage: Int = 20): TerminologySourceSearchResult!
}

type DatasetSearchResult {
  items: [Dataset!]!
  pagination: Pagination!
  facets: DatasetFacets!
}

type Dataset {
  id: String!
  title: [LanguageString!]!
  description: [LanguageString!]!
  publisher: [Agent!]!
  terminology_source: [Vocabulary!]!
  language: [String!]!
  format: [String!]!
  date_posted: String
  size: Int
  status: String!
  iiif_manifest_count: Int
  iiif: Boolean!
  nde_schema_ap: Boolean!
}

type LanguageString {
  language: String
  value: String!
}

type Agent {
  id: String!
  label: [LanguageString!]!
}

type Vocabulary {
  id: String!
  label: [LanguageString!]!
}

type Pagination {
  total: Int!
  page: Int!
  perPage: Int!
}

type DatasetFacets {
  publisher: [ValueBucket!]!
  class: [ValueBucket!]!
  terminology_source: [ValueBucket!]!
  language: [ValueBucket!]!
  format: [ValueBucket!]!
  size: [RangeBucket!]!
  status: [ValueBucket!]!
  iiif: [BooleanBucket!]!
  nde_schema_ap: [BooleanBucket!]!
  linked_data: [BooleanBucket!]!
  terms: [BooleanBucket!]!
  persistent_uris: [BooleanBucket!]!
}

type ValueBucket {
  value: String!
  count: Int!
  label: [LanguageString!]
}

type RangeBucket {
  min: Float
  max: Float
  count: Int!
}

type BooleanBucket {
  value: Boolean!
  count: Int!
}

"""
Sibling keys are combined with AND. Use \`or\` for a disjunction, and \`and\` when a query needs more than one of them.
"""
input DatasetWhere {
  id: StringFilter
  publisher: StringFilter
  catalog: StringFilter
  class: StringFilter
  terminology_source: StringFilter
  format: StringFilter
  size: IntRange
  status: StringFilter
  nde_schema_ap: Boolean

  """
  A disjunction: a document matches when ANY of these criteria holds. Combined with the sibling keys by AND, so it widens across fields without widening the query as a whole.
  """
  or: [DatasetCriterion!]

  """
  Further groups of conditions, all of which apply. The way to carry a second \`or\` disjunction alongside the first.
  """
  and: [DatasetWhere!]
}

input StringFilter {
  in: [String!]
}

input IntRange {
  min: Int
  max: Int
}

"""
A condition on exactly one field. Used inside \`or\`, where the criteria are alternatives.
"""
input DatasetCriterion @oneOf {
  id: StringFilter
  publisher: StringFilter
  catalog: StringFilter
  class: StringFilter
  terminology_source: StringFilter
  format: StringFilter
  size: IntRange
  status: StringFilter
  nde_schema_ap: Boolean
}

input DatasetOrderBy {
  field: DatasetSortField!
  direction: SortDirection! = DESC
}

enum DatasetSortField {
  RELEVANCE
  TITLE
  DATE_POSTED
  SIZE
  STATUS_RANK
}

enum SortDirection {
  ASC
  DESC
}

type OrganizationSearchResult {
  items: [Organization!]!
  pagination: Pagination!
}

type Organization {
  id: String!
  label: [LanguageString!]!
}

"""
Sibling keys are combined with AND. Use \`or\` for a disjunction, and \`and\` when a query needs more than one of them.
"""
input OrganizationWhere {
  id: StringFilter

  """
  A disjunction: a document matches when ANY of these criteria holds. Combined with the sibling keys by AND, so it widens across fields without widening the query as a whole.
  """
  or: [OrganizationCriterion!]

  """
  Further groups of conditions, all of which apply. The way to carry a second \`or\` disjunction alongside the first.
  """
  and: [OrganizationWhere!]
}

"""
A condition on exactly one field. Used inside \`or\`, where the criteria are alternatives.
"""
input OrganizationCriterion @oneOf {
  id: StringFilter
}

input OrganizationOrderBy {
  field: OrganizationSortField!
  direction: SortDirection! = DESC
}

enum OrganizationSortField {
  RELEVANCE
}

type ClassSearchResult {
  items: [Class!]!
  pagination: Pagination!
}

type Class {
  id: String!
  label: [LanguageString!]!
}

"""
Sibling keys are combined with AND. Use \`or\` for a disjunction, and \`and\` when a query needs more than one of them.
"""
input ClassWhere {
  id: StringFilter

  """
  A disjunction: a document matches when ANY of these criteria holds. Combined with the sibling keys by AND, so it widens across fields without widening the query as a whole.
  """
  or: [ClassCriterion!]

  """
  Further groups of conditions, all of which apply. The way to carry a second \`or\` disjunction alongside the first.
  """
  and: [ClassWhere!]
}

"""
A condition on exactly one field. Used inside \`or\`, where the criteria are alternatives.
"""
input ClassCriterion @oneOf {
  id: StringFilter
}

input ClassOrderBy {
  field: ClassSortField!
  direction: SortDirection! = DESC
