{%- comment -%}
    Renders the attribute table of one node shape. The caller writes the heading,
    so that a Schema.org and a DCAT table can share it.
    nodeShape.or holds every sh:or of the shape, each a list of alternatives
    of which one is required.
{%- endcomment -%}
<table>
    {% assign class = nodeShape.targetClass | default: nodeShape.class | default: targetClass -%}
    <caption>[{{ class }}]({% render 'expand-iri', curie: class %}) properties</caption>
    <thead>
        <tr>
            <th>Property</th>
            <th>Description</th>
            <th>Cardinality</th>
            <th>Usage</th>
        </tr>
    </thead>
    <tbody>
        {% if nodeShape.nodeKind == "IRI" %}
        <tr>
            <th scope="row">@id</th>
            <td>The HTTP [[IRI]] of the {{ name }}.</td>
            <td>1</td>
            <td>Required</td>
        </tr>
        {% elsif nodeShape['nde:futureChange'].nodeKind == "IRI" %}
        <tr>
            <th scope="row">@id</th>
            <td>The HTTP [[IRI]] of the {{ name }}.</td>
            <td>1</td>
            <td>Recommended<br><small><a href="#v{{ nodeShape['nde:futureChange']['nde:version'] | split: '.' | first }}">v{{ nodeShape['nde:futureChange']['nde:version'] }}</a>: must be IRI</small></td>
        </tr>
        {% endif %}
        {% assign or_alternatives = '' | split: '' -%}
        {% for or_list in nodeShape.or -%}
            {% assign or_alternatives = or_alternatives | concat: or_list -%}
        {% endfor -%}
        {% assign or_properties = or_alternatives | map: 'property' -%}
        {% assign merged_properties = nodeShape.property | concat: or_properties | mergePropertiesByPath -%}
        {% for property in merged_properties %}
        {% unless property.path %}{% continue %}{% endunless %}
        {%- assign alternatives = '' -%}
        {%- for or_list in nodeShape.or -%}
            {%- assign or_paths = or_list | map: 'property' | map: 'path' -%}
            {%- if or_paths contains property.path -%}
                {%- assign alternatives = or_paths -%}
            {%- endif -%}
        {%- endfor -%}
        {%- comment -%}
            The merged row takes each key from the first shape on the path that has it,
            so its severity can belong to a sibling (such as a langString warning).
            Whether the property is required comes from the shape with the sh:minCount.
        {%- endcomment -%}
        {%- assign requirement = nil -%}
        {%- for shape in nodeShape.property -%}
            {%- if shape.path == property.path and shape.minCount > 0 -%}
                {%- assign requirement = shape -%}
                {%- break -%}
            {%- endif -%}
        {%- endfor -%}
        {%- assign is_enforced = false -%}
        {%- assign becomes_required = false -%}
        {%- if requirement -%}
            {%- assign requirement_severity = requirement.severity | default: "Violation" -%}
            {%- if requirement_severity == "Violation" -%}
                {%- assign is_enforced = true -%}
            {%- elsif requirement['nde:futureChange'].severity == "Violation" -%}
                {%- assign becomes_required = true -%}
            {%- endif -%}
        {%- endif -%}
        {%- assign pattern_str = property.pattern | default: "" -%}
        {%- assign is_date_shape = pattern_str contains "[0-9]{4}" -%}
        {%- assign description = property.description | lang: "en"
            | replace: "IANA media types", "[[IANA-MEDIA-TYPES]]"
            | replace: "BCP 47", "[[!BCP47]]"
            | replace: "DERA", "[[!DERA]]"
            | replace: "IRI", "[[!IRI]]"
            | replace: "web API", "[=web API=]"
            | replace: "MUST", "*MUST*"
            | replace: "SHOULD", "*SHOULD*"
        -%}
        <tr>
            <th scope="row">[{{ property.path }}]({% render 'expand-iri', curie: property.path %})</th>
            <td>
                {%- if is_date_shape -%}
                    {%- if description != "" -%}{{ description }} {% endif -%}
                    {%- if name == 'Distribution' -%}See [[#distribution-date]].{%- else -%}See [[#dataset-date]].{%- endif -%}
                {%- else -%}
                    {%- case property.path -%}
                    {%- when "schema:publisher", "schema:creator", "dct:publisher", "dct:creator" -%}
                        {{ description }} See [[#creator-publisher-information]].
                    {%- when "schema:contactPoint", "dcat:contactPoint" -%}
                        {{ description }} See [[#contact]].
                    {%- when "schema:mainEntityOfPage", "dcat:landingPage" -%}
                        {{ description }} See [[#resolvable-iris]].
                    {%- when "schema:usageInfo", "dct:conformsTo" -%}
                        {{ description }} See [[#usage-information]].
                    {%- when "schema:license", "dct:license" -%}
                        {{ description }} See [[#dataset-license]].
                    {%- when "schema:distribution", "dcat:distribution" -%}
                        {{ description }} See [[#dataset-distributions]].
                    {%- when "schema:version", "dcat:version" -%}
                        {{ description }} See [[#dataset-versions]].
                    {%- when "schema:name", "schema:description", "dct:title", "dct:description" -%}
                        {{ description }}{% if name == 'Dataset' %} See [[#dataset-basic]].{% endif %}
                    {%- else -%}
                        {{ description }}
                    {%- endcase -%}
                {%- endif -%}
            </td>
            <td>
                {%- assign min_count = 0 -%}
                {%- if is_enforced and alternatives == '' -%}{%- assign min_count = requirement.minCount -%}{%- endif -%}
                {%- assign current_min = min_count | default: 0 -%}
                {%- assign current_max = property.maxCount | default: "n" -%}
                {%- if property.maxCount == 0 -%}
                    {%- assign current_card = "0" -%}
                {%- elsif min_count and min_count == property.maxCount -%}
                    {%- capture current_card %}{{ min_count }}{% endcapture -%}
                {%- else -%}
                    {%- capture current_card %}{{ current_min }}..{{ current_max }}{% endcapture -%}
                {%- endif -%}
                {{ current_card }}
                {%- if property['nde:futureChange'] -%}
                    {%- assign change = property['nde:futureChange'] -%}
                    {%- assign future_min = current_min -%}
                    {%- assign future_max = current_max -%}
                    {%- if change.minCount -%}{%- assign future_min = change.minCount -%}{%- endif -%}
                    {%- if change.maxCount -%}{%- assign future_max = change.maxCount -%}{%- endif -%}
                    {%- if becomes_required -%}{%- assign future_min = requirement.minCount -%}{%- endif -%}
                    {%- if change.severity == "Violation" and current_min == 0 and property.maxCount != 0 -%}
                        {%- unless change.datatype or change.pattern or change.nodeKind or property.datatype or property.pattern or property.nodeKind or property.or or property.not or property.node.pattern -%}
                            {%- assign future_min = 1 -%}
                        {%- endunless -%}
                    {%- endif -%}
                    {%- if future_max == 0 -%}
                        {%- assign future_card = "0" -%}
                    {%- elsif future_min == future_max -%}
                        {%- capture future_card %}{{ future_min }}{% endcapture -%}
                    {%- else -%}
                        {%- capture future_card %}{{ future_min }}..{{ future_max }}{% endcapture -%}
                    {%- endif -%}
                    {%- if future_card != current_card -%}
                        <br><small><a href="#v{{ change['nde:version'] | split: '.' | first }}">v{{ change['nde:version'] }}</a>: {{ future_card }}</small>
                    {%- endif -%}
                {%- endif -%}
            </td>
            <td>
                {% assign is_required = false -%}
                {% if property.maxCount == 0 -%}
                    Discouraged
                {% elsif alternatives != '' -%}
                    Required: {{ alternatives | join: ' or ' }}
                    {% assign is_required = true -%}
                {% elsif is_enforced -%}
                    Required
                    {% assign is_required = true -%}
                {% else -%}
                    Recommended
                {% endif -%}
                {% if property['nde:futureChange'] -%}
                    {% assign change = property['nde:futureChange'] -%}
                    {% assign future_text = "" -%}
                    {% if change.datatype -%}
                        {% assign future_text = change.datatype | replace: 'http://www.w3.org/2001/XMLSchema#', 'xsd:' | prepend: 'must be ' -%}
                    {% elsif change.pattern -%}
                        {% capture future_text %}must match <code>{{ change.pattern }}</code>{% endcapture -%}
                    {% elsif change.nodeKind == "IRI" and change.severity != "Violation" -%}
                        {% assign future_text = "must be IRI" -%}
                    {% elsif change.maxCount -%}
                        {% assign future_text = change.maxCount | prepend: "max " -%}
                    {% elsif change.severity == "Violation" and property.maxCount == 0 -%}
                        {% assign future_text = "no longer allowed" -%}
                    {% elsif change.severity == "Violation" and property.nodeKind == "IRI" -%}
                        {% assign future_text = "must be IRI" -%}
                    {% elsif change.severity == "Violation" and property.datatype -%}
                        {% assign future_text = property.datatype | replace: 'http://www.w3.org/2001/XMLSchema#', 'xsd:' | replace: 'http://www.w3.org/1999/02/22-rdf-syntax-ns#', 'rdf:' | prepend: 'must be ' -%}
                    {% elsif change.severity == "Violation" and property.node.pattern -%}
                        {% capture future_text %}must match <code>{{ property.node.pattern }}</code>{% endcapture -%}
                    {% elsif change.severity == "Violation" and is_date_shape -%}
                        {% assign future_text = "must be valid ISO 8601" -%}
                    {% elsif change.severity == "Violation" and property.or -%}
                        {%- assign has_iri_alt = false -%}
                        {%- assign has_date_alt = false -%}
                        {%- for or_list in property.or -%}
                            {%- for alt in or_list -%}
                                {%- if alt.nodeKind == "IRI" -%}{%- assign has_iri_alt = true -%}{%- endif -%}
                                {%- assign alt_pattern = alt.pattern | default: "" -%}
                                {%- if alt_pattern contains "{4}" -%}{%- assign has_date_alt = true -%}{%- endif -%}
                            {%- endfor -%}
                        {%- endfor -%}
                        {%- if has_iri_alt and has_date_alt -%}
                            {% assign future_text = "must be valid ISO 8601 or IRI" -%}
                        {%- endif -%}
                    {% elsif change.severity == "Violation" and property.not.pattern -%}
                        {%- assign not_pattern = property.not.pattern -%}
                        {%- if not_pattern contains "https?" or not_pattern contains "http" -%}
                            {% assign future_text = "IRIs not allowed" -%}
                        {%- endif -%}
                    {% endif -%}
                    {% if becomes_required -%}
                        {% if future_text == "" -%}
                            {% assign future_text = "becomes required" -%}
                        {% elsif future_text != "becomes required" -%}
                            {% assign future_text = future_text | prepend: "becomes required; " -%}
                        {% endif -%}
                    {% endif -%}
                    {% if future_text == "" and change.severity == "Violation" and is_required == false and property.maxCount != 0 -%}
                        {% assign future_text = "becomes required" -%}
                    {% endif -%}
                    {% if future_text != "" -%}
                        <br><small><a href="#v{{ change['nde:version'] | split: '.' | first }}">v{{ change['nde:version'] }}</a>: {{ future_text }}</small>
                    {% endif -%}
                {% endif -%}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
