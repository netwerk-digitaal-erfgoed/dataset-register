{
  "@context": "https://schema.org/",
  "@type": "Dataset",
  "@id": "https://example.com/id/dataset/schema-org",
  "name": {
    "@value": "Dataset with nested nodes",
    "@language": "en"
  },
  "publisher": {
    "@id": "https://example.com/id/publisher",
    "@type": "Organization",
    "name": {
      "@value": "Publisher",
      "@language": "en"
    },
    "identifier": [
      {
        "@type": "PropertyValue",
        "propertyID": "ISIL",
        "value": "NL-HaKB",
        "@id": "https://example.com/id/identifier/isil"
      },
      {
        "@type": "PropertyValue",
        "propertyID": "KvK",
        "@id": "https://example.com/id/identifier/kvk"
      }
    ]
  },
  "citation": [
    {
      "@type": "ScholarlyArticle",
      "name": "An article with a URL",
      "url": "https://doi.org/10.1145/3604951.3605520"
    },
    {
      "@type": "ScholarlyArticle",
      "name": "An article without a URL"
    },
    "A citation as text"
  ]
}
