{
  "@context": "https://schema.org/",
  "@type": "DataCatalog",
  "@id": "https://example.com/catalog",
  "name": "Catalog whose datasets each embed the same publisher",
  "dataset": [
    {
      "@type": "Dataset",
      "@id": "https://example.com/dataset/1",
      "name": "Dataset 1",
      "license": "http://creativecommons.org/publicdomain/zero/1.0/",
      "publisher": {
        "@type": "Organization",
        "@id": "https://example.com/publisher",
        "name": "Publisher",
        "contactPoint": { "@type": "ContactPoint", "name": "Datamanager", "email": "data@example.com" }
      },
      "creator": {
        "@type": "Organization",
        "@id": "https://example.com/publisher",
        "name": "Publisher",
        "contactPoint": { "@type": "ContactPoint", "name": "Datamanager", "email": "data@example.com" }
      }
    },
    {
      "@type": "Dataset",
      "@id": "https://example.com/dataset/2",
      "name": "Dataset 2",
      "license": "http://creativecommons.org/publicdomain/zero/1.0/",
      "publisher": {
        "@type": "Organization",
        "@id": "https://example.com/publisher",
        "name": "Publisher",
        "contactPoint": { "@type": "ContactPoint", "name": "Datamanager", "email": "data@example.com" }
      },
      "creator": {
        "@type": "Organization",
        "@id": "https://example.com/publisher",
        "name": "Publisher",
        "contactPoint": { "@type": "ContactPoint", "name": "Datamanager", "email": "data@example.com" }
      }
    },
    {
      "@type": "Dataset",
      "@id": "https://example.com/dataset/3",
      "name": "Dataset 3",
      "license": "http://creativecommons.org/publicdomain/zero/1.0/",
      "publisher": {
        "@type": "Organization",
        "@id": "https://example.com/publisher",
        "name": "Publisher",
        "contactPoint": { "@type": "ContactPoint", "name": "Helpdesk", "email": "help@example.com" }
      }
    }
  ]
}
